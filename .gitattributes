# Site images and audio live in Git LFS. Netlify pulls them at build time
# (see netlify.toml), and scripts/check-media.ts fails the build if any are
# still LFS pointers. Video does not go in the repo: it lives on Cloudflare Stream.
public/**/*.webp filter=lfs diff=lfs merge=lfs -text
public/**/*.png filter=lfs diff=lfs merge=lfs -text
public/**/*.jpg filter=lfs diff=lfs merge=lfs -text
public/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
public/**/*.gif filter=lfs diff=lfs merge=lfs -text
public/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
public/**/*.wav filter=lfs diff=lfs merge=lfs -text
public/**/*.m4a filter=lfs diff=lfs merge=lfs -text
